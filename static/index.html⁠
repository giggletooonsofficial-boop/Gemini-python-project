<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global AI Council</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' }
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen font-sans">
    <div class="max-w-5xl mx-auto p-6">
        <header class="flex justify-between items-center mb-8 border-b border-gray-700 pb-4">
            <h1 class="text-3xl font-bold tracking-tight">Global AI Council</h1>
            <span class="px-3 py-1 bg-blue-900 text-blue-200 rounded-full text-sm font-medium">Phase 1 Prototype</span>
        </header>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4">Convene a New Council</h2>
            <div class="flex gap-4">
                <input type="text" id="objective" class="flex-1 bg-gray-100 dark:bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter the problem or objective (e.g., Design a secure cloud architecture)">
                <button onclick="startMeeting()" class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded font-medium transition-colors">Start Meeting</button>
            </div>
        </div>

        <div id="meetingRoom" class="hidden">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-2xl font-bold">Live Meeting Room</h2>
                <span id="statusBadge" class="px-3 py-1 rounded-full text-sm font-bold uppercase tracking-wider"></span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Participants Panel -->
                <div class="col-span-1 bg-white dark:bg-gray-800 rounded-lg shadow p-4 h-[600px] overflow-y-auto">
                    <h3 class="text-lg font-semibold mb-4 border-b border-gray-700 pb-2">Council Members</h3>
                    <ul id="agentList" class="space-y-4"></ul>
                </div>
                
                <!-- Discussion Thread -->
                <div class="col-span-1 md:col-span-2 bg-white dark:bg-gray-800 rounded-lg shadow p-4 h-[600px] flex flex-col">
                    <h3 class="text-lg font-semibold mb-4 border-b border-gray-700 pb-2">Discussion Transcript</h3>
                    <div id="transcript" class="flex-1 overflow-y-auto space-y-4 pr-2"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentMeetingId = null;
        let pollInterval = null;

        async function startMeeting() {
            const objective = document.getElementById('objective').value;
            if (!objective) return;

            const res = await fetch('/api/meetings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ objective })
            });
            const data = await res.json();
            currentMeetingId = data.meeting_id;
            
            document.getElementById('meetingRoom').classList.remove('hidden');
            document.getElementById('transcript').innerHTML = '';
            document.getElementById('agentList').innerHTML = '';
            
            if (pollInterval) clearInterval(pollInterval);
            pollInterval = setInterval(fetchMeetingState, 1500);
            fetchMeetingState();
        }

        async function fetchMeetingState() {
            if (!currentMeetingId) return;
            const res = await fetch(`/api/meetings/${currentMeetingId}`);
            const data = await res.json();

            // Update Status Badge
            const badge = document.getElementById('statusBadge');
            badge.textContent = data.status;
            badge.className = `px-3 py-1 rounded-full text-sm font-bold uppercase tracking-wider ${
                data.status === 'completed' ? 'bg-green-900 text-green-200' : 'bg-yellow-900 text-yellow-200 animate-pulse'
            }`;

            // Render Agents
            document.getElementById('agentList').innerHTML = data.agents.map(a => `
                <li class="bg-gray-100 dark:bg-gray-700 p-3 rounded border-l-4 border-blue-500">
                    <div class="font-bold">${a.name}</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">${a.role}</div>
                    <div class="text-xs mt-1 text-blue-400 uppercase">[${a.provider}]</div>
                </li>
            `).join('');

            // Render Transcript
            document.getElementById('transcript').innerHTML = data.messages.map(m => {
                if (m.agent_name === 'System') {
                    return `<div class="text-center text-sm font-bold text-gray-400 my-4 border-b border-gray-700 pb-2">${m.content}</div>`;
                }
                return `
                <div class="bg-gray-100 dark:bg-gray-700 p-3 rounded">
                    <div class="flex justify-between items-baseline mb-1">
                        <span class="font-bold text-blue-400">${m.agent_name}</span>
                        <span class="text-xs text-gray-400">${new Date(m.timestamp).toLocaleTimeString()}</span>
                    </div>
                    <p class="text-sm leading-relaxed">${m.content}</p>
                </div>`;
            }).join('');

            // Auto-scroll transcript
            const transcriptBox = document.getElementById('transcript');
            transcriptBox.scrollTop = transcriptBox.scrollHeight;

            if (data.status === 'completed' || data.status.startsWith('failed')) {
                clearInterval(pollInterval);
            }
        }
    </script>
</body>
</html>
