from fastapi.testclient import TestClient
from main import app
from database import create_db_and_tables

client = TestClient(app)

def setup_module(module):
    create_db_and_tables()

def test_create_meeting():
    response = client.post("/api/meetings", json={"objective": "Test the testing system"})
    assert response.status_code == 200
    data = response.json()
    assert "meeting_id" in data
    assert data["status"] == "pending"

def test_get_meeting_state():
    # Create
    response = client.post("/api/meetings", json={"objective": "Test state"})
    meeting_id = response.json()["meeting_id"]
    
    # Fetch
    res = client.get(f"/api/meetings/{meeting_id}")
    assert res.status_code == 200
    data = res.json()
    
    assert data["objective"] == "Test state"
    assert len(data["agents"]) == 3 # Default setup roles
