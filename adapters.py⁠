from typing import Protocol
import asyncio

class ProviderAdapter(Protocol):
    async def generate_response(self, system_prompt: str, context: str) -> str:
        """Generate a response based on the role and meeting context."""
        ...

class SimulatedAdapter:
    """Phase 1: Simulated adapter for predictable development and testing."""
    def __init__(self, agent_name: str, role: str):
        self.agent_name = agent_name
        self.role = role

    async def generate_response(self, system_prompt: str, context: str) -> str:
        # Simulate network latency and "thinking" time
        await asyncio.sleep(2)
        
        if "Opening" in context:
            return f"[{self.agent_name}] As the {self.role}, my initial analysis of the objective indicates several key dependencies we must address."
        elif "Discussion" in context:
            return f"[{self.agent_name}] Reviewing the previous points, I agree with the core premise, but we must ensure we mitigate the associated risks."
        elif "Synthesis" in context:
            return f"[{self.agent_name}] Synthesizing the discussion: We have reached a consensus. The recommended action is to proceed with the proposed architecture with added security checks."
        
        return f"[{self.agent_name}] Acknowledged."

def get_adapter(provider: str, agent_name: str, role: str) -> ProviderAdapter:
    # In Phase 2, this will route to GeminiAdapter, OpenAIAdapter, etc.
    if provider == "simulated":
        return SimulatedAdapter(agent_name, role)
    raise ValueError(f"Unknown provider: {provider}")
